generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  PLAYER
  STAFF
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  full_name  String
  user_type  UserType
  avatar_url String?
  created_at DateTime @default(now())

  player_profile    PlayerProfile?
  staff_teams       TeamStaffMember[]
  player_teams      TeamPlayerMember[]
  created_events    Event[]              @relation("EventCreator")
  staff_assignments EventStaffAssignment[]
  notifications     Notification[]
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  can_create_event Boolean @default(false)

  staff_members     TeamStaffMember[]
  event_assignments EventStaffAssignment[]
}

model Team {
  id   String @id @default(uuid())
  name String

  staff_members  TeamStaffMember[]
  player_members TeamPlayerMember[]
  events         Event[]
}

model TeamStaffMember {
  user_id String
  team_id String
  role_id String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id])

  @@id([user_id, team_id])
}

model TeamPlayerMember {
  user_id String
  team_id String

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  team Team @relation(fields: [team_id], references: [id], onDelete: Cascade)

  @@id([user_id, team_id])
}

model PlayerProfile {
  id         String    @id @default(uuid())
  user_id    String    @unique
  birth_date DateTime?
  position   String?
  jersey_no  Int?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model EventType {
  id   String @id @default(uuid())
  name String @unique

  subtypes EventSubtype[]
  events   Event[]
}

model EventSubtype {
  id            String @id @default(uuid())
  name          String
  event_type_id String

  event_type EventType @relation(fields: [event_type_id], references: [id], onDelete: Cascade)
  events     Event[]
}

model Location {
  id      String  @id @default(uuid())
  name    String
  address String?

  events Event[]
}

model Event {
  id               String      @id @default(uuid())
  title            String
  event_type_id    String
  event_subtype_id String?
  team_id          String
  opponent         String?
  start_time       DateTime
  end_time         DateTime?
  arrival_time     DateTime?
  location_id      String
  status           EventStatus @default(DRAFT)
  created_by       String
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt

  event_type    EventType     @relation(fields: [event_type_id], references: [id])
  event_subtype EventSubtype? @relation(fields: [event_subtype_id], references: [id])
  team          Team          @relation(fields: [team_id], references: [id])
  location      Location      @relation(fields: [location_id], references: [id])
  creator       User          @relation("EventCreator", fields: [created_by], references: [id])

  staff_assignments EventStaffAssignment[]
  notifications     Notification[]
}

model EventStaffAssignment {
  id       String @id @default(uuid())
  event_id String
  user_id  String
  role_id  String

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [role_id], references: [id])
}

model Notification {
  id          String    @id @default(uuid())
  event_id    String
  change_type String
  user_id     String
  sent_at     DateTime  @default(now())
  read_at     DateTime?

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}
